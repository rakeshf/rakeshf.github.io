SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Run the market refresh every 15 minutes during trading hours.
*/15 9-15 * * 1-5 /bin/bash /workspaces/rakeshf.github.io/scripts/update_data.sh >> /workspaces/rakeshf.github.io/logs/scripts/cron_wrapper.log 2>&1
